{
  "openapi": "3.1.1",
  "info": {
    "title": "SmartGN - Monitoring & Analytics",
    "description": "Live consumption metrics, consumption history, multi-meter analytics, simple expense estimates and Pro reports. Owns an independent PostgreSQL database, caches aggregates in Redis (Cache-Aside) and queries Telemetry and Billing over private gRPC.",
    "license": {
      "name": "MIT"
    },
    "version": "v1"
  },
  "paths": {
    "/api/v1/analytics/live": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Latest reading of an authorized meter",
        "description": "Returns the most recent reading (volume, pressure, gas presence, valve state) and its freshness. Requires VIEW_CONSUMPTION on the meter. Not cached.",
        "parameters": [
          {
            "name": "meterId",
            "in": "query",
            "description": "Meter identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest reading",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveReadingDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meterId"
          },
          "401": {
            "description": "Missing or invalid IAM token"
          },
          "403": {
            "description": "No current grant on the meter"
          },
          "503": {
            "description": "IAM or Telemetry temporarily unavailable"
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/analytics/consumption": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Consolidated consumption of authorized meters",
        "description": "Consumption (difference of cumulative readings), estimated cost and simple monthly estimate per meter. Defaults to the current month. Cache-Aside with Redis (header X-Cache: HIT or MISS).",
        "parameters": [
          {
            "name": "meterIds",
            "in": "query",
            "description": "Meter identifiers (max 100)",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Period start (ISO 8601). Default: first day of the current month",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Period end (ISO 8601). Default: now",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption per meter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meters or period"
          },
          "401": {
            "description": "Missing or invalid IAM token"
          },
          "403": {
            "description": "No current grant on one of the meters"
          },
          "503": {
            "description": "IAM or Telemetry temporarily unavailable"
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/analytics/reports": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Generate consolidated consumption report (Pro)",
        "description": "Requires USE_REPORTS on every meter and an active Pro subscription confirmed by Billing over gRPC. The report is stored in PostgreSQL and cached in Redis (header X-Cache).",
        "parameters": [
          {
            "name": "meterIds",
            "in": "query",
            "description": "Meter identifiers (max 100)",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Period start (ISO 8601)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Period end (ISO 8601)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionReportDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meters or period"
          },
          "401": {
            "description": "Missing or invalid IAM token"
          },
          "403": {
            "description": "No grant on a meter or Pro subscription required"
          },
          "503": {
            "description": "IAM, Billing or Telemetry temporarily unavailable"
          }
        },
        "security": [
          {}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumptionReportDto": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "totalVolumeM3": {
            "type": "number",
            "format": "double"
          },
          "totalEstimatedCost": {
            "type": "number",
            "format": "double"
          },
          "meterRows": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ReportLineDto"
            }
          }
        },
        "additionalProperties": false
      },
      "ConsumptionResponseDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "calculatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "pricePerM3": {
            "type": "number",
            "format": "double"
          },
          "totalVolumeM3": {
            "type": "number",
            "format": "double"
          },
          "totalEstimatedCost": {
            "type": "number",
            "format": "double"
          },
          "meters": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/MeterConsumptionDto"
            }
          }
        },
        "additionalProperties": false
      },
      "LiveReadingDto": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "format": "uuid"
          },
          "measuredAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "totalVolumeM3": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "pressureKpa": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "gasDetected": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "valveOpen": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "freshness": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "MeterConsumptionDto": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "format": "uuid"
          },
          "volumeM3": {
            "type": "number",
            "format": "double"
          },
          "estimatedCost": {
            "type": "number",
            "format": "double"
          },
          "readingsCount": {
            "type": "integer",
            "format": "int32"
          },
          "firstReadingAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastReadingAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "monthlyEstimateM3": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "monthlyEstimateCost": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ReportLineDto": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "format": "uuid"
          },
          "volumeM3": {
            "type": "number",
            "format": "double"
          },
          "estimatedCost": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Current IAM JWT. The service verifies the active session and operation-specific meter/function permissions.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceAuth": {
        "type": "http",
        "description": "Private service credential, independent of user JWTs. Internal routes must remain outside public gateway routing.",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Analytics",
      "description": "Authorized live readings, consumption history and Pro reports."
    }
  ]
}
